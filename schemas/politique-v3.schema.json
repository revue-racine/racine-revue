{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:olistic:confiance:schema:politique:3",
  "title": "Politique de confiance v3 — socle contractuel dormant",
  "description": "Ce schéma ne sait représenter qu'une politique non active et non autorisante. Modèles, fournisseurs et endpoints restent vides jusqu'à un protocole ultérieur.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "version", "generation", "etat", "racine", "type_predicat",
    "demandeurs", "depots", "selection", "relecteurs", "fraicheur", "limites"
  ],
  "properties": {
    "format": {
      "const": "olistic.confiance.politique/3"
    },
    "version": {
      "const": 1
    },
    "generation": {
      "const": 3
    },
    "etat": {
      "const": "dormant"
    },
    "racine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proprietaire", "proprietaire_id", "depot", "depot_id", "workflow", "nom_workflow", "ref"],
      "properties": {
        "proprietaire": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{1,39}$"
        },
        "proprietaire_id": {
          "type": "integer",
          "minimum": 1
        },
        "depot": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,100}$"
        },
        "depot_id": {
          "type": "integer",
          "minimum": 1
        },
        "workflow": {
          "const": ".github/workflows/revue.yml"
        },
        "nom_workflow": {
          "const": "revue"
        },
        "ref": {
          "const": "refs/heads/main"
        }
      }
    },
    "type_predicat": {
      "const": "urn:olistic:confiance:attestation-revue:3"
    },
    "demandeurs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["login", "id"],
        "properties": {
          "login": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,39}$"
          },
          "id": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "depots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alias", "repository_id"],
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,39}$"
          },
          "repository_id": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "selection": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["famille_auteur", "famille_relecture"],
        "properties": {
          "famille_auteur": {
            "enum": ["gpt-codex-family", "claude-family"]
          },
          "famille_relecture": {
            "enum": ["gpt-codex-family", "claude-family"]
          }
        }
      }
    },
    "relecteurs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["famille", "actif", "acceptable", "modeles", "fournisseurs", "endpoints"],
        "properties": {
          "famille": {
            "enum": ["gpt-codex-family", "claude-family"]
          },
          "actif": {
            "const": false
          },
          "acceptable": {
            "const": false
          },
          "modeles": {
            "type": "array",
            "maxItems": 0
          },
          "fournisseurs": {
            "type": "array",
            "maxItems": 0
          },
          "endpoints": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    "fraicheur": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coupure", "validite_s", "tolerance_instant_s", "derive_horloge_s"],
      "properties": {
        "coupure": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "validite_s": {
          "type": "integer",
          "minimum": 60,
          "maximum": 2592000
        },
        "tolerance_instant_s": {
          "type": "integer",
          "minimum": 60,
          "maximum": 7200
        },
        "derive_horloge_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        }
      }
    },
    "limites": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corps_demande_octets", "diff_octets"],
      "properties": {
        "corps_demande_octets": {
          "type": "integer",
          "minimum": 64,
          "maximum": 4096
        },
        "diff_octets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000000
        }
      }
    }
  }
}
